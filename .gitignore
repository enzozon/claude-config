# NUNCA versionar credenciais - segunda barreira caso o sincronizar.ps1 mude
.credentials.json
*.credentials*
.env
*.pem
*.key

# Banco do claude-mem fica de fora: guarda trechos de conversa que ja continham
# uma chave de API em texto puro. Se quiser preservar a memoria, use pen drive.
*.db
*.db-wal
*.db-shm
.claude-mem/

# Historico de conversas do Claude por projeto: muito grande (100+ MB)
# Sincroniza APENAS a memoria (*.md files), nao os .jsonl e .meta.json
config/.claude/projects/**/*.jsonl
config/.claude/projects/**/*.meta.json
config/.claude/projects/**/tool-results/
config/.claude/projects/**/subagents/

# Ruido
*.log
node_modules/
